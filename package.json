{
  "name": "dsh-workflow-studio",
  "version": "0.1.0",
  "description": "流程工坊 · Workflow Studio — a visual, ordered event-flow editor for DSH: split a project into ordered small events, layered by service function, and drive them from both the agent and the page.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woem2436/dsh-workflow-studio.git"
  },
  "homepage": "https://github.com/woem2436/dsh-workflow-studio#readme",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "web/**/*",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workflow",
    "coze",
    "orchestration",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node dev/harness.js",
    "test": "node --test tests/store.test.js tests/api.test.js"
  },
  "license": "MIT"
}
